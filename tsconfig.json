{
    "compilerOptions":  {
                            "target":  "ES2018",
                            "module":  "Preserve",
                            "moduleResolution":  "Bundler",
                            "jsx":  "react-jsx",
                            "strict":  true,
                            "noEmit":  true,
                            "lib":  [
                                        "es2015"
                                    ],
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "noUnusedLocals":  true
                        },
    "include":  [
                    "src",
                    "remotion.config.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "out",
                    "jobs",
                    "preview"
                ]
}
